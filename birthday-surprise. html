<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>For Sumiee ❤️ — From Adii</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#09030a;color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}
body{overflow-x:hidden}
.bg{position:fixed;inset:0;background:radial-gradient(circle at 50% 20%,#5b173b 0,#180817 38%,#09030a 75%);z-index:-2}
.hearts{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
.heart{position:absolute;bottom:-40px;font-size:20px;opacity:.65;animation:float 9s linear infinite}
@keyframes float{to{transform:translateY(-115vh) rotate(360deg);opacity:0}}
section{min-height:100vh;padding:42px 20px;display:flex;align-items:center;justify-content:center}
.card{width:min(900px,100%);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(12px);border-radius:28px;padding:28px;box-shadow:0 25px 80px rgba(0,0,0,.45)}
.hero img{width:100%;max-height:68vh;object-fit:cover;border-radius:22px;display:block}
h1{font-size:clamp(38px,10vw,76px);margin:22px 0 8px;text-align:center;line-height:1}
h2{font-size:clamp(28px,7vw,48px);text-align:center;margin:0 0 18px}
p{font-size:18px;line-height:1.75;color:#f4dce8}
.center{text-align:center}
.subtitle{text-align:center;color:#f6b8d2;font-size:18px}
.btn{border:0;border-radius:999px;padding:14px 24px;background:#ff4f9a;color:white;font-weight:700;font-size:16px;cursor:pointer;box-shadow:0 10px 30px rgba(255,79,154,.25)}
.hidden{display:none}
.letter{font-size:19px;line-height:1.9}
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.gallery img{width:100%;height:360px;object-fit:cover;border-radius:18px}
.gallery img:nth-child(3){grid-column:1/-1;height:420px}
.small{font-size:14px;color:#dcb5c9}
.count{font-size:clamp(32px,8vw,62px);font-weight:800;text-align:center;color:#ff9fc5}
footer{text-align:center;padding:30px;color:#caa8b9}
@media(max-width:600px){.card{padding:18px}.gallery{grid-template-columns:1fr}.gallery img:nth-child(3){grid-column:auto;height:360px}.gallery img{height:390px}}
</style>
</head>
<body>
<div class="bg"></div><div class="hearts" id="hearts"></div>

<section id="start">
  <div class="card center">
    <div style="font-size:60px">🎁</div>
    <h2>Sumiee, tumhare liye...</h2>
    <p>Ek chhota sa surprise hai. ❤️<br>Ready ho?</p>
    <button class="btn" onclick="openGift()">Tap to Open 💖</button>
  </div>
</section>

<section id="main" class="hidden">
  <div class="card hero">
    <img src="data:image/jpeg;base64," alt="Sumiee">
    <h1>Happy Birthday<br>Sumiee ❤️</h1>
    <div class="subtitle">7 September — tumhara special day ✨</div>
    <p class="center">Aaj ka din mere liye bhi special hai… kyunki aaj tum duniya mein aayi thi. 🥹❤️</p>
  </div>
</section>

<section id="letter" class="hidden">
  <div class="card">
    <h2>Ek baat dil se... 💌</h2>
    <p class="letter">
      Sumiee,<br><br>
      Kabhi-kabhi words kam pad jaate hain ye batane ke liye ki koi insaan hamare liye kitna special hai.
      Tum mere liye bas ek naam nahi ho — tum meri favourite smile, meri favourite person aur meri life ki ek bahut khoobsurat feeling ho. ❤️<br><br>
      Tumhari khushi mere liye bahut matter karti hai. Main chahta hoon ki tum hamesha smile karo,
      apne dreams achieve karo aur life mein jitni khushiyan deserve karti ho, sab tumhe milein. 🥹<br><br>
      Aur haan… agar kabhi tumhe lage ki koi tumhare saath khada hai, toh yaad rakhna —
      <b>Adii hamesha tumhari smile ka reason banne ki koshish karega. ❤️</b><br><br>
      Happy Birthday meri special Sumiee. 🎂💖
    </p>
  </div>
</section>

<section id="memories" class="hidden">
  <div class="card">
    <h2>Our Little Memories 📸</h2>
    <div class="gallery">
      <img src="data:image/jpeg;base64," alt="Memory 1">
      <img src="data:image/png;base64," alt="Memory 2">
      <img src="data:image/jpeg;base64," alt="Memory 3">
      <img src="data:image/png;base64," alt="Memory 4">
    </div>
    <p class="center small">Har photo ke saath ek alag feeling judi hai. ❤️</p>
  </div>
</section>

<section id="count" class="hidden">
  <div class="card center">
    <div style="font-size:58px">🎂</div>
    <h2>7 September</h2>
    <div class="count" id="countdown">Birthday loading...</div>
    <p>Countdown se zyada important ek hi cheez hai — <b>tumhari smile. ❤️</b></p>
  </div>
</section>

<section id="final" class="hidden">
  <div class="card center">
    <img src="data:image/jpeg;base64," alt="Sumiee" style="width:100%;max-height:55vh;object-fit:cover;border-radius:22px">
    <h2 style="margin-top:24px">Always yours, Adii ❤️</h2>
    <p>Chahe waqt badle, memories badhein, ya life hume kahin bhi le jaye…<br>
    meri birthday wish tumhare liye hamesha same rahegi:<br><br>
    <b>“Bas tum hamesha khush rehna.” 🥹❤️</b></p>
    <div style="font-size:38px;margin-top:15px">❤️ 🫶 ❤️</div>
  </div>
</section>

<footer class="hidden" id="foot">Made with ❤️ by Adii for Sumiee</footer>

<script>
function openGift(){
  document.getElementById('start').style.display='none';
  ['main','letter','memories','count','final','foot'].forEach(id=>document.getElementById(id).classList.remove('hidden'));
  document.getElementById('main').scrollIntoView({behavior:'smooth'});
  startHearts();
}
function startHearts(){
  const box=document.getElementById('hearts');
  for(let i=0;i<28;i++){
    const h=document.createElement('div'); h.className='heart'; h.textContent=['❤️','💗','💕','✨'][i%4];
    h.style.left=Math.random()*100+'%'; h.style.animationDelay=(Math.random()*7)+'s';
    h.style.animationDuration=(6+Math.random()*7)+'s'; h.style.fontSize=(14+Math.random()*20)+'px';
    box.appendChild(h);
  }
}
function nextBirthday(){
  const now=new Date(), year=now.getFullYear();
  let d=new Date(year,8,7,0,0,0);
  if(d<=now)d=new Date(year+1,8,7,0,0,0);
  return d;
}
function tick(){
  const diff=nextBirthday()-new Date();
  const days=Math.floor(diff/86400000), hrs=Math.floor(diff/3600000)%24, mins=Math.floor(diff/60000)%60;
  document.getElementById('countdown').textContent=days+'d '+hrs+'h '+mins+'m';
}
tick(); setInterval(tick,30000);
</script>
</body>
</html>
